generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/sales_crm/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  companies   Company[]
  contacts    Contact[]
  leads       Lead[]
  deals       Deal[]
  activities  Activity[]
  tasks       Task[]
  documents   Document[]
  quotes      Quote[]
  contracts   Contract[]
  pipelines   Pipeline[]
  forecasts   Forecast[]
  tags        Tag[]
  notes       Note[]
  settings    WorkspaceSettings?

  @@index([slug])
}

model WorkspaceSettings {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique
  workspace               Workspace @relation(fields: [workspaceId], references: [id])
  idorVulnerabilityEnabled Boolean @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("rep") // admin, manager, rep
  workspaceId   String?
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  deals         Deal[]    @relation("DealOwner")
  activities    Activity[]
  tasks         Task[]    @relation("TaskAssignee")
  createdTasks  Task[]    @relation("TaskCreator")
  leads         Lead[]    @relation("LeadOwner")
  notes         Note[]

  @@index([workspaceId])
  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id              String   @id @default(cuid())
  name            String
  industry        String?
  size            String?
  revenue         Float?
  website         String?
  phone           String?
  email           String?
  address         String?
  city            String?
  state           String?
  country         String?
  description     String?
  confidentialNotes String?
  negotiatedPricing String?
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  documents       Document[]
  notes           Note[]
  contracts       Contract[]
  quotes          Quote[]
  transactions    Transaction[]

  @@index([workspaceId])
  @@index([name])
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  department  String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deals       Deal[]
  activities  Activity[]
  notes       Note[]

  @@index([workspaceId])
  @@index([companyId])
  @@index([email])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      String?  // web, referral, cold-call, event, social
  status      String   @default("new") // new, contacted, qualified, unqualified, converted
  score       Int      @default(0)
  ownerId     String?
  owner       User?    @relation("LeadOwner", fields: [ownerId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  convertedDealId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([ownerId])
  @@index([status])
}

model Pipeline {
  id          String   @id @default(cuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  stages      DealStage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
}

model DealStage {
  id          String   @id @default(cuid())
  name        String
  order       Int
  probability Float    @default(0)
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id])
  deals       Deal[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pipelineId])
}

model Deal {
  id              String    @id @default(cuid())
  title           String
  value           Float     @default(0)
  probability     Float     @default(0)
  expectedCloseDate DateTime?
  actualCloseDate DateTime?
  status          String    @default("open") // open, won, lost
  margin          Float?
  internalNotes   String?
  stageId         String?
  stage           DealStage? @relation(fields: [stageId], references: [id])
  ownerId         String?
  owner           User?     @relation("DealOwner", fields: [ownerId], references: [id])
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  contactId       String?
  contact         Contact?  @relation(fields: [contactId], references: [id])
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  activities      Activity[]
  documents       Document[]
  notes           Note[]
  quotes          Quote[]

  @@index([workspaceId])
  @@index([stageId])
  @@index([ownerId])
  @@index([companyId])
  @@index([status])
}

model Activity {
  id          String   @id @default(cuid())
  type        String   // call, email, meeting, note, task
  subject     String
  description String?
  date        DateTime @default(now())
  duration    Int?     // minutes
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([companyId])
  @@index([dealId])
  @@index([type])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("medium") // low, medium, high, urgent
  status      String   @default("pending") // pending, in_progress, completed, cancelled
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId   String?
  creator     User?    @relation("TaskCreator", fields: [creatorId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueDate])
}

model Document {
  id              String   @id @default(cuid())
  name            String
  cloudStoragePath String?
  isPublic        Boolean  @default(false)
  contentType     String?
  size            Int?
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  dealId          String?
  deal            Deal?    @relation(fields: [dealId], references: [id])
  contractId      String?
  contract        Contract? @relation(fields: [contractId], references: [id])
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId])
  @@index([companyId])
  @@index([dealId])
  @@index([contractId])
}

model Quote {
  id          String   @id @default(cuid())
  number      String
  status      String   @default("draft") // draft, sent, accepted, rejected
  validUntil  DateTime?
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float    @default(0)
  notes       String?
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  lineItems   QuoteLineItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([dealId])
}

model QuoteLineItem {
  id          String @id @default(cuid())
  description String
  quantity    Int    @default(1)
  unitPrice   Float  @default(0)
  total       Float  @default(0)
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Contract {
  id          String   @id @default(cuid())
  title       String
  status      String   @default("draft") // draft, under_review, signed, expired
  value       Float?
  startDate   DateTime?
  endDate     DateTime?
  terms       String?
  parties     String?
  confidential Boolean @default(true)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  documents   Document[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([companyId])
  @@index([status])
}

model Forecast {
  id          String   @id @default(cuid())
  month       DateTime
  predicted   Float    @default(0)
  actual      Float?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([month])
}

model Tag {
  id          String @id @default(cuid())
  name        String
  color       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([name, workspaceId])
  @@index([workspaceId])
}

model Note {
  id          String   @id @default(cuid())
  content     String
  confidential Boolean @default(false)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id])
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@index([companyId])
  @@index([dealId])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // payment, refund, credit
  amount      Float
  description String?
  date        DateTime @default(now())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([date])
}
